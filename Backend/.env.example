# ===========================================================================
# Huddle — Backend Environment Variables
# ===========================================================================
# Copy this file to `.env` and fill in the values.
#
# Firebase Admin SDK credentials come from the Firebase console:
#   Project Settings > Service Accounts > Generate New Private Key
# Open the downloaded JSON and copy the values below.
# ===========================================================================

# Server
PORT=5000
NODE_ENV=development

# Firebase Admin SDK (required — all three must be set)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key including the BEGIN/END markers.
# Keep the surrounding quotes so newlines are preserved.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# CORS: comma-separated list of allowed frontend origins
# Defaults to http://localhost:5173,http://localhost:3000 when not set
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
