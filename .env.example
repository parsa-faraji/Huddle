# ===========================================================================
# Huddle — Frontend Environment Variables (Vite)
# ===========================================================================
# Copy this file to `.env.local` and fill in the values from the Firebase
# console: Project Settings > General > Your apps > Web app.
#
# Vite exposes only variables prefixed with VITE_ to client-side code.
# NEVER put secrets (private keys, service account creds) here — they
# would be embedded in the JavaScript bundle and visible to anyone.
# ===========================================================================

# Firebase web app configuration (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only needed if you use Firebase Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# Backend API base URL (no trailing slash)
# Defaults to http://localhost:5000 when not set
VITE_API_URL=http://localhost:5000
